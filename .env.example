# Operations dashboard sign-in (/admin)
# VITE_ADMIN_PASSWORD_HASH is the SHA-256 hex of "email:password" (email in lowercase). Generate it with:
#   node -e "console.log(require('crypto').createHash('sha256').update('ops@example.com:YOUR-PASSWORD').digest('hex'))"
# Put real values in .env.local (git-ignored) and in Vercel > Settings > Environment Variables.
VITE_ADMIN_EMAIL=ops@example.com
VITE_ADMIN_PASSWORD_HASH=
